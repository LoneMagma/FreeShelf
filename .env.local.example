# ============================================================
# FreeShelf — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ─── Clerk Auth ──────────────────────────────────────────────
# Get from: https://dashboard.clerk.com → Your App → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ─── Supabase ─────────────────────────────────────────────────
# Get from: https://supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Upstash Redis (replaces Vercel KV) ───────────────────────
# Option A — Vercel deployment:
#   Connect an Upstash Redis store in Vercel Dashboard → Storage
#   Vercel auto-injects these two vars. Nothing to do manually.
#
# Option B — Local dev with Upstash:
#   Create free DB at https://console.upstash.com
#   Copy REST URL + token here.
#   Without these vars, the app uses an in-memory cache (mock data).
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ─── IsThereAnyDeal API ───────────────────────────────────────
# Register free at: https://isthereanydeal.com/dev/app/
# Free tier: 100 requests/day
# With hourly cron + 10-min flash cron we use ~168 req/day on pro,
# but free tier crons only run in production so local dev = 0 req/day.
# Without this key, ITAD deals are skipped (Epic + GOG still work).
ITAD_API_KEY=

# ─── Cron Security ───────────────────────────────────────────
# Protects /api/cron/* from unauthorized calls.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ─── Optional: IGDB (richer metadata — Phase 2) ──────────────
# Get from: https://dev.twitch.tv/console → Applications
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Clerk webhook (for auto-avatar on signup)
# Get from: Clerk Dashboard → Webhooks → your endpoint → Signing Secret
CLERK_WEBHOOK_SECRET=

# Resend (resend.com — free tier, no credit card)
# Get API key from: resend.com/api-keys
# Verify your domain at: resend.com/domains
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=FreeShelf <alerts@yourdomain.com>

# Site URL (used for OG images, unsubscribe links, email links)
# In development: http://localhost:3000
# In production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=https://freeshelf.app

# Suppress Clerk's dev-mode overlay (the red 'N | 1 Issue' badge)
# Add this to your .env.local to hide it during development
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=true
